# Copy this file to .env and fill in the values. NEVER commit .env to git.

# Token from @BotFather (a NEW bot, not the student union one)
BOT_TOKEN=put-your-bot-token-here

# Telegram user IDs of admins who approve texts and pay withdrawals (comma separated)
ADMIN_IDS=7517585192

# Everything is counted in kiro.
# How many kiro are added for each approved submission
REWARD_KIRO=1
# Smallest number of kiro a user can withdraw
MIN_WITHDRAW_KIRO=10

DB_PATH=earn.db
